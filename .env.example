# --- Database (Neon Postgres) ---
# Get this from Vercel Dashboard -> Storage -> Create Database -> Neon Postgres,
# or from https://console.neon.tech directly.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram, copy the token it gives you.
TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenReplaceMe"

# --- Telegram targets (whitelist) ---
# One env var per dropdown target. The KEY after TG_CHAT_ is what the client
# sends (e.g. "soc"); the value is the real chat ID and never reaches the client.
# Add a matching entry in src/lib/targets.ts when you add a new one here.
TG_CHAT_SOC="-1000000000001"
TG_CHAT_TEST_GROUP="-1000000000002"
TG_CHAT_BLUE_TEAM="-1000000000003"
TG_CHAT_PRIBADI="123456789"

# --- Session ---
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-hex-chars-random-value"

# --- TOTP secret encryption ---
# AES-256-GCM key (32 bytes, hex-encoded = 64 hex chars) used to encrypt TOTP
# secrets at rest in the database. Generate the same way as SESSION_SECRET.
TOTP_ENCRYPTION_KEY="replace-with-64-hex-chars-random-value"
